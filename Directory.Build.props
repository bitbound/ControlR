<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>

    <Authors>Jared Goodwin</Authors>
    <Copyright>©️ $([System.DateTime]::Now.Year) Bitbound</Copyright>
    <RepositoryUrl>https://github.com/bitbound/controlr.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/bitbound/controlr</PackageProjectUrl>
    <Company>Bitbound</Company>
    <Description>Open-source remote control and remote access.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      EnforceCodeStyleInBuild makes the IDE-prefixed style rules in .editorconfig report during a
      command-line build instead of only in the editor.  IDE0005 additionally requires
      GenerateDocumentationFile or the compiler fails the project outright.
    -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- BrandPrefix is replaced by customize.ps1 for whitelabel builds. -->
  <PropertyGroup>
    <BrandPrefix>ControlR</BrandPrefix>
    <_BrandSuffix Condition="$(MSBuildProjectName.StartsWith('ControlR')) AND !$(MSBuildProjectName.StartsWith('ControlR.Web.'))">
      $(MSBuildProjectName.Substring(8))</_BrandSuffix>
    <AssemblyName Condition="'$(_BrandSuffix)' != ''">$(BrandPrefix)$(_BrandSuffix.Trim())</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <WindowsTargetFramework>net10.0-windows8.0</WindowsTargetFramework>
    <MacTargetFramework>net10.0-macos</MacTargetFramework>
    <MacTargetPlatformVersion>26.0</MacTargetPlatformVersion>
    <LinuxTargetFramework>net10.0</LinuxTargetFramework>
  </PropertyGroup>

  <!--
    S125: Allow commented code.  Useful for TODOs and examples.
    AV0029: Allow multiple calls to `AddOpenApi`.  Needed because different overloads expose different configuration options.
    BB0001: Custom Bitbound analyzer.  Only warn about member ordering.
    NU1901-NU1904: NuGet warnings should not completely break the build.
    CS1591: Missing XML comment for publicly visible type or member.  GenerateDocumentationFile is on
    only so that IDE0005 runs during a build.  Documenting every public member is not a goal yet.
   -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);S125;AV0029;CS1591;</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);BB0001;NU1901;NU1902;NU1903;NU1904;</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup
    Condition="$(RuntimeIdentifier.StartsWith('win')) OR ('$(RuntimeIdentifier)' == '' AND $([System.OperatingSystem]::IsWindows()))">
    <XplatTarget>$(WindowsTargetFramework)</XplatTarget>
    <DefineConstants>$(DefineConstants);IS_WINDOWS</DefineConstants>
    <IsWindows>true</IsWindows>
  </PropertyGroup>

  <PropertyGroup
    Condition="$(RuntimeIdentifier.StartsWith('osx')) OR ('$(RuntimeIdentifier)' == '' AND $([System.OperatingSystem]::IsMacOS()))">
    <XplatTarget>$(MacTargetFramework)</XplatTarget>
    <DefineConstants>$(DefineConstants);IS_MACOS;IS_UNIX</DefineConstants>
    <IsMacOS>true</IsMacOS>
    <IsUnix>true</IsUnix>
  </PropertyGroup>

  <PropertyGroup
    Condition="$(RuntimeIdentifier.StartsWith('linux')) OR ('$(RuntimeIdentifier)' == '' AND $([System.OperatingSystem]::IsLinux()))">
    <XplatTarget>$(LinuxTargetFramework)</XplatTarget>
    <DefineConstants>$(DefineConstants);IS_LINUX;IS_UNIX</DefineConstants>
    <IsLinux>true</IsLinux>
    <IsUnix>true</IsUnix>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="Bitbound.Analyzers.MemberOrder" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsNuGetPackage)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>