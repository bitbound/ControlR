@attribute [Route(ClientRoutes.TenantServiceAccounts)]
@attribute [Authorize(Policy = PolicyNames.RequireServiceAccountRead)]

<PageTitle>Service Accounts</PageTitle>

<PrimaryTitle>
  Service Accounts
</PrimaryTitle>

<GridToolbar @bind-SearchValue="_searchString" OnRefresh="Refresh">
  <Actions>
    <MudButton Variant="Variant.Outlined"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="CreateAccount">
      New Account
    </MudButton>
  </Actions>
</GridToolbar>

<MudDataGrid T="TenantServiceAccountDto"
              Items="_accounts"
              Hover="true"
              Loading="_loading"
              QuickFilter="QuickFilter"
              Breakpoint="Breakpoint.Sm">
  <Columns>
    <HierarchyColumn T="TenantServiceAccountDto" />
    <PropertyColumn Property="x => x.Name" Title="Name" />
    <PropertyColumn Property="x => x.Description" Title="Description" />
    <TemplateColumn Title="Enabled" Sortable="false" Filterable="false">
      <CellTemplate>
        <MudSwitch T="bool" Value="@context.Item.IsEnabled"
                   ValueChanged="@((enabled) => ToggleEnabled(context.Item, enabled))"
                   Color="Color.Primary"
                   Disabled="@(_togglingIds.Contains(context.Item.Id))" />
      </CellTemplate>
    </TemplateColumn>
    <TemplateColumn Title="ID" Sortable="false" Filterable="false">
      <CellTemplate>
        <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center">
          <MudText Typo="Typo.body2">@(TruncateId(context.Item.Id))</MudText>
          <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                         Size="Size.Small"
                         OnClick="@(() => CopyId(context.Item.Id))" />
        </MudStack>
      </CellTemplate>
    </TemplateColumn>
    <PropertyColumn Property="x => x.CreatedAt" Title="Created" />
    <TemplateColumn Title="Credentials" Sortable="false" Filterable="false">
      <CellTemplate>
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
          <MudChip T="string" Size="Size.Small" Color="Color.Default">@context.Item.Credentials.Count</MudChip>
          <MudText Typo="Typo.caption" Color="Color.Info">
            @(GetActiveCount(context.Item.Credentials)) active
          </MudText>
        </MudStack>
      </CellTemplate>
    </TemplateColumn>
    <TemplateColumn Title="Actions" Sortable="false" Filterable="false">
      <CellTemplate>
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Info" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopRight">
          <MudMenuItem Icon="@Icons.Material.Filled.Add" IconColor="Color.Info" OnClick="@(() => AddCredential(context.Item))">Add Credential</MudMenuItem>
          <MudMenuItem Icon="@Icons.Material.Filled.Edit" IconColor="Color.Primary" OnClick="@(() => EditAccount(context.Item))">Edit</MudMenuItem>
          <MudMenuItem Icon="@Icons.Material.Filled.AdminPanelSettings" IconColor="Color.Info" OnClick="@(() => EditPermissions(context.Item))">Edit Permissions</MudMenuItem>
          <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="@(() => DeleteAccount(context.Item))">Delete</MudMenuItem>
        </MudMenu>
      </CellTemplate>
    </TemplateColumn>
  </Columns>
  <PagerContent>
    <MudDataGridPager T="TenantServiceAccountDto" />
  </PagerContent>
  <ChildRowContent Context="parentItem">
    <MudDataGrid T="TenantServiceAccountCredentialDto"
                 Items="@parentItem.Item.Credentials"
                 Hover="true"
                 Breakpoint="Breakpoint.Sm"
                 class="credential-grid">
      <Columns>
        <PropertyColumn Property="x => x.Name" Title="Name" />
        <TemplateColumn Title="Status" Sortable="false">
          <CellTemplate>
            @if (context.Item.RevokedAt is not null)
            {
              <MudChip Size="Size.Small" Color="Color.Error">Revoked</MudChip>
            }
            else if (context.Item.ExpiresAt is not null && context.Item.ExpiresAt <= TimeProvider.GetUtcNow())
            {
              <MudChip Size="Size.Small" Color="Color.Warning">Expired</MudChip>
            }
            else
            {
              <MudChip Size="Size.Small" Color="Color.Success">Active</MudChip>
            }
          </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.CreatedAt" Title="Created" />
        <PropertyColumn Property="x => x.LastUsedAt" Title="Last Used" />
        <TemplateColumn Title="Expires" SortBy="x => x.ExpiresAt" Filterable="false">
          <CellTemplate>
            @(context.Item.ExpiresAt?.ToLocalTime().ToString("g") ?? "Never")
          </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Actions" Sortable="false">
          <CellTemplate>
            @if (_canRotateCredentials)
            {
              @if (context.Item.RevokedAt is null && (context.Item.ExpiresAt is null || context.Item.ExpiresAt > TimeProvider.GetUtcNow()))
              {
                <MudTooltip Text="Revoke credential">
                  <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                 Color="Color.Error"
                                 Size="Size.Small"
                                 OnClick="@(() => RevokeCredential(parentItem.Item.Id, context.Item.Id))" />
                </MudTooltip>
              }
              else
              {
                <MudTooltip Text="Delete credential">
                  <MudIconButton Icon="@Icons.Material.Filled.DeleteForever"
                                 Color="Color.Error"
                                 Size="Size.Small"
                                 OnClick="@(() => PurgeCredential(parentItem.Item.Id, context.Item.Id))" />
                </MudTooltip>
              }
            }
          </CellTemplate>
        </TemplateColumn>
      </Columns>
    </MudDataGrid>
  </ChildRowContent>
</MudDataGrid>
