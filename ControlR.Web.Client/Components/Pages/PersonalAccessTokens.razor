@attribute [Route(ClientRoutes.PersonalAccessTokens)]
@attribute [Authorize(Policy = PolicyNames.RequirePersonalAccessTokenSelfRead)]
@using PATDtos = ControlR.Libraries.Api.Contracts.Dtos.ServerApi.V1.PersonalAccessTokens

<div>
  <PageTitle>Personal Access Tokens</PageTitle>

  <PrimaryTitle>
    Personal Access Tokens
  </PrimaryTitle>

  <MudAlert Severity="Severity.Info" Class="mb-4 pat-info">
    <ul class="ms-4">
      <li>Authenticate requests by adding the token to the "<code>x-personal-token</code>" header.</li>
      <li>Prefer Restricted tokens scoped to only what they need (recommended).</li>
      <li><strong>Inherit Owner</strong>: The token can do everything your account can do.</li>
      <li><strong>Restricted</strong>: The token can only do what its permission scopes allow.</li>
    </ul>
  </MudAlert>

  <MudCard Class="mb-4">
    <MudCardContent>
      <MudGrid Spacing="2">
        <MudItem xs="12" sm="5">
          <MudTextField @bind-Value="_newTokenName" Label="Token Name" Placeholder="Enter a friendly name for the personal access token"
            Immediate="true" OnKeyDown="OnKeyDown" Disabled="_isLoading" />
        </MudItem>
        <MudItem xs="12" sm="3">
          <MudSelect T="PersonalAccessTokenPermissionMode" @bind-Value="_newTokenMode" Label="Permission Mode" Disabled="_isLoading">
            <MudSelectItem Value="PersonalAccessTokenPermissionMode.Restricted">Restricted (scoped)</MudSelectItem>
            <MudSelectItem Value="PersonalAccessTokenPermissionMode.InheritOwner">Inherit Owner (full access)</MudSelectItem>
          </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-end">
          <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="CreatePersonalAccessToken"
            Disabled="@(!CanCreatePersonalAccessToken)">
            Create PAT
          </MudButton>
        </MudItem>
      </MudGrid>
    </MudCardContent>
  </MudCard>

  <MudDataGrid T="PATDtos.PersonalAccessTokenResponseDto" Items="@_personalAccessTokens" Loading="_isLoading" ShowColumnOptions="true" Filterable="true"
    SortMode="SortMode.Single">
    <ToolBarContent>
      <MudSpacer />
      <MudTooltip Text="Refresh">
        <MudIconButton Variant="Variant.Outlined" Color="Color.Info" Class="ml-2"
                      Icon="@Icons.Material.Filled.Refresh" OnClick="Refresh" />
      </MudTooltip>
    </ToolBarContent>
    <Columns>
      <PropertyColumn Property="x => x.Name" Title="Name" />
      <TemplateColumn Title="Mode" Sortable="true" SortBy="@(x => x.PermissionMode)">
        <CellTemplate>
          <MudChip T="string" Size="Size.Small"
                   Color="@(context.Item.PermissionMode == PersonalAccessTokenPermissionMode.Restricted ? Color.Info : Color.Warning)">
            @context.Item.PermissionMode
          </MudChip>
        </CellTemplate>
      </TemplateColumn>
      <PropertyColumn Property="x => x.CreatedAt" Title="Created" />
      <PropertyColumn Property="x => x.LastUsed" Title="Last Used">
        <CellTemplate>
          @if (context.Item.LastUsed.HasValue)
          {
            @context.Item.LastUsed.Value
          }
          else
          {
            <text>Never</text>
          }
        </CellTemplate>
      </PropertyColumn>
      <TemplateColumn Title="Permissions" Sortable="true" SortBy="@(x => x.PermissionCount)">
        <CellTemplate>
          @context.Item.PermissionCount
        </CellTemplate>
      </TemplateColumn>
      <TemplateColumn Title="Actions" Sortable="false" Filterable="false">
        <CellTemplate>
          <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Info" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopRight">
            <MudMenuItem Icon="@Icons.Material.Filled.Edit" IconColor="Color.Info" OnClick="() => RenamePersonalAccessToken(context.Item)">Rename</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.AdminPanelSettings" IconColor="Color.Info" OnClick="() => ManagePermissions(context.Item)">Edit Permissions</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="() => DeletePersonalAccessToken(context.Item)">Delete</MudMenuItem>
          </MudMenu>
        </CellTemplate>
      </TemplateColumn>
    </Columns>
  </MudDataGrid>
</div>
