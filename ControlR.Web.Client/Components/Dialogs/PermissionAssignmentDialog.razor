@using ControlR.Libraries.Api.Contracts.Enums
@using ControlR.Web.Client.Components.Shared

<MudDialog>
  <DialogContent>
    <MudGrid Spacing="2">
      <MudItem xs="12">
        <MudAutocomplete T="PermissionPickerRow"
                         Value="SelectedPickerRow"
                         ValueChanged="HandlePermissionRowChanged"
                         SearchFunc="SearchPermissionRows"
                         Label="Permission"
                         Clearable="true"
                         MaxItems="null"
                         Required="true"
                         Dense="true"
                         MaxHeight="420"
                         ResetValueOnEmptyText="true"
                         CoerceText="true"
                         CoerceValue="false"
                         ItemDisabledFunc="@(row => row.IsHeader)"
                         PopoverClass="permission-catalog-popover"
                         ToStringFunc="@(row => row?.Display ?? string.Empty)">
          <ItemDisabledTemplate Context="row">
            <MudText Typo="Typo.overline" Class="permission-catalog-group-label">@row.Display</MudText>
          </ItemDisabledTemplate>
        </MudAutocomplete>
      </MudItem>
      <MudItem xs="6">
        <MudSelect T="PermissionEffect" Value="_effect" ValueChanged="HandleEffectChanged" Label="Effect">
          <MudSelectItem Value="PermissionEffect.Allow">Allow</MudSelectItem>
          <MudSelectItem Value="PermissionEffect.Deny">Deny</MudSelectItem>
        </MudSelect>
      </MudItem>
      <MudItem xs="6">
        <MudSelect T="PermissionScopeKind" @bind-Value="_scopeKind" Label="Scope Kind" Disabled="_selectedPermission is null">
          @foreach (var scopeKind in AvailableScopeKinds(_selectedPermission))
          {
            var kind = scopeKind;
            <MudSelectItem Value="kind">@ScopeKindLabel(kind)</MudSelectItem>
          }
        </MudSelect>
      </MudItem>
      <MudItem xs="12">
        <ScopeAutocomplete ScopeKind="_scopeKind"
                           @bind-SelectedId="_scopeId"
                           Label="Scope"
                           Class="mb-2" />
      </MudItem>
      <MudItem xs="12">
        <MudTextField T="string" @bind-Value="_notes" Label="Notes (optional)" Sizing="@InputSizing.Auto" MaxLines="4" />
      </MudItem>
      <MudItem xs="12">
        <MudSwitch T="bool" @bind-Value="_isEnabled" Label="Enabled" Color="Color.Primary" />
      </MudItem>
    </MudGrid>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">Cancel</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Submit">
      @(IsEdit ? "Save" : "Create")
    </MudButton>
  </DialogActions>
</MudDialog>
