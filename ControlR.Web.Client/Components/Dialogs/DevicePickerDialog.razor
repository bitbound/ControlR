@using ControlR.Libraries.Api.Contracts.Dtos.ServerApi.Internal

<MudDialog>
  <DialogContent>
    <MudStack Spacing="2">
      <MudTextField T="string"
                    @bind-Value="_searchText"
                    Label="Search devices"
                    Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search"
                    Immediate="true"
                    DebounceInterval="400"
                    OnDebounceIntervalElapsed="OnSearchChanged"
                    Clearable="true" />

      @if (_loading)
      {
        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
      }
      else
      {
        <MudPaper MaxHeight="350px" Class="overflow-y-auto">
          <MudList T="DeviceResponseDto"
                   SelectedValue="_selectedDevice"
                   SelectedValueChanged="HandleSelectedChanged"
                   SelectionMode="SelectionMode.SingleSelection"
                   Color="Color.Primary">
            @foreach (var device in _devices)
            {
              <MudListItem T="DeviceResponseDto" Value="@device">
                @DeviceDisplay.GetFullDisplayName(device)
              </MudListItem>
            }
          </MudList>
          @if (_devices.Count == 0)
          {
            <MudText Typo="Typo.body2" Class="pa-4 mud-text-secondary">No devices found.</MudText>
          }
        </MudPaper>

        <MudPagination Selected="_currentPage" Count="_totalPages" BoundaryCount="1" SelectedChanged="OnPageChanged" Size="Size.Small" />
      }
    </MudStack>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">Cancel</MudButton>
    <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="Select" Disabled="@(_selectedDevice is null)">
      Select
    </MudButton>
  </DialogActions>
</MudDialog>
