@implements IDisposable
@using System.Security.Claims

@inject AuthenticationStateProvider AuthState
@inject NavigationManager NavMan
@inject ILogger<NavMenu> Logger
@inject IPublicServerSettingsProvider PublicRegistingsProvider
@inject ISnackbar Snackbar
@inject ILazyInjector<IControlrInternalApi> ControlrApi

<MudNavMenu>
  <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
    Home
  </MudNavLink>
  <MudNavLink Disabled="!_isAuthenticated" Href="@(ClientRoutes.Deploy)" Match="NavLinkMatch.Prefix"
              Icon="@Icons.Material.Filled.RocketLaunch">
    Deploy
  </MudNavLink>
  <AuthorizeView Policy="@(PolicyNames.RequireInstallerKeyRead)">
    <MudNavLink Disabled="!_isAuthenticated" Href="@(ClientRoutes.InstallerKeys)" Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.InstallDesktop">
      Installer Keys
    </MudNavLink>
  </AuthorizeView>
  <AuthorizeView Policy="@(PolicyNames.RequirePersonalAccessTokenSelfRead)">
    <MudNavLink Disabled="!_isAuthenticated" Href="@(ClientRoutes.PersonalAccessTokens)" Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.Key">
      Access Tokens
    </MudNavLink>
  </AuthorizeView>
  <MudNavLink Disabled="!_isAuthenticated" Href="@(ClientRoutes.Settings)" Match="NavLinkMatch.Prefix"
              Icon="@Icons.Material.Filled.Settings">
    Settings
  </MudNavLink>

  @if (_canSeeTenantAdmin)
  {
    <div class="ms-2 mt-5">
      <MudText Typo="Typo.caption" Color="Color.Default">
        Tenant Admin
      </MudText>
    </div>
    <AuthorizeView Policy="@(PolicyNames.RequireUsersRead)">
      <MudNavLink Href="@(ClientRoutes.Users)" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">
        Users
      </MudNavLink>
    </AuthorizeView>
    <AuthorizeView Policy="@(PolicyNames.RequireUserGroupsRead)">
      <MudNavLink Href="@(ClientRoutes.UserGroups)" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Groups">
        User Groups
      </MudNavLink>
    </AuthorizeView>
    <AuthorizeView Policy="@(PolicyNames.RequireDeviceGroupsRead)">
      <MudNavLink Href="@(ClientRoutes.DeviceGroups)" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Devices">
        Device Groups
      </MudNavLink>
    </AuthorizeView>
    <AuthorizeView Policy="@(PolicyNames.RequireCustomersRead)">
      <MudNavLink Href="@(ClientRoutes.Customers)" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Business">
        Customers
      </MudNavLink>
    </AuthorizeView>
    <AuthorizeView Policy="@(PolicyNames.RequirePermissionAssignmentsRead)">
      <MudNavLink Href="@(ClientRoutes.Permissions)" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assignment">
        Permissions
      </MudNavLink>
    </AuthorizeView>
    @*
      This tenant link is suppressed for users who already hold the server-scoped
      Authorization Logs permission, so they don't see the same link in both the
      Tenant Admin and Server Admin sections.
    *@
    @if (!_canSeeServerAuthorizationLogs)
    {
      <AuthorizeView Policy="@(PolicyNames.RequireAuthorizationLogsRead)">
        <MudNavLink Href="@(ClientRoutes.AuthorizationLogs)" Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Filled.History">
          Authorization Logs
        </MudNavLink>
      </AuthorizeView>
    }
    <AuthorizeView Policy="@(PolicyNames.RequireTagsWrite)">
      <MudNavLink Href="@(ClientRoutes.Tags)" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.NewLabel">
        Device Tags
      </MudNavLink>
    </AuthorizeView>
    <AuthorizeView Policy="@(PolicyNames.RequireServiceAccountRead)">
      <MudNavLink Href="@(ClientRoutes.TenantServiceAccounts)" Match="NavLinkMatch.Prefix"
                  Icon="@Icons.Material.Filled.Badge">
        Tenant Service Accounts
      </MudNavLink>
    </AuthorizeView>
    <AuthorizeView Policy="@(PolicyNames.RequireTenantUsersWrite)">
      <MudNavLink Href="@(ClientRoutes.Invite)" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Email">
        Invite
      </MudNavLink>
    </AuthorizeView>
    <AuthorizeView Policy="@(PolicyNames.RequirePermissionAssignmentsRead)">
      <MudNavLink Href="@(ClientRoutes.EffectivePermissions)" Match="NavLinkMatch.Prefix"
                  Icon="@Icons.Material.Filled.FactCheck">
        Effective Permissions
      </MudNavLink>
    </AuthorizeView>
    <AuthorizeView Policy="@(PolicyNames.RequireTenantSettingsRead)">
      <MudNavLink Href="@(ClientRoutes.TenantSettings)" Match="NavLinkMatch.Prefix"
                  Icon="@Icons.Material.Filled.Settings">
        Tenant Settings
      </MudNavLink>
    </AuthorizeView>
  }
  @if (_canSeeServerAdmin)
  {
    <div class="ms-2 mt-5">
      <MudText Typo="Typo.caption" Color="Color.Default">
        Server Admin
      </MudText>
    </div>
    <AuthorizeView Policy="@(PolicyNames.RequireServerServiceAccountsRead)">
      <MudNavLink Href="@(ClientRoutes.ServerServiceAccounts)" Match="NavLinkMatch.Prefix"
                  Icon="@Icons.Material.Filled.SupervisorAccount">
        Server Service Accounts
      </MudNavLink>
    </AuthorizeView>
    <AuthorizeView Policy="@(PolicyNames.RequireServerAuthorizationLogsRead)">
      <MudNavLink Href="@(ClientRoutes.ServerAuthorizationLogs)" Match="NavLinkMatch.Prefix"
                  Icon="@Icons.Material.Filled.History">
        Authorization Logs
      </MudNavLink>
    </AuthorizeView>
    <AuthorizeView Policy="@(PolicyNames.RequireServerSettingsWrite)">
      <MudNavLink Href="@(ClientRoutes.ServerSettings)" Match="NavLinkMatch.Prefix"
                  Icon="@Icons.Material.Filled.Settings">
        Server Settings
      </MudNavLink>
    </AuthorizeView>
    <AuthorizeView Policy="@(PolicyNames.RequireServerTelemetryRead)">
      <MudNavLink Href="@(ClientRoutes.ServerStats)" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.QueryStats">
        Server Stats
      </MudNavLink>
    </AuthorizeView>
    <AuthorizeView Policy="@(PolicyNames.RequireServerTelemetryRead)">
      <MudNavLink Href="@(ClientRoutes.ServerLogs)" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.TextSnippet">
        Server Logs
      </MudNavLink>
    </AuthorizeView>
  }

  <MudDivider Class="mt-2 mb-2" />

  <MudNavLink Href="@(ClientRoutes.About)" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.QuestionMark">
    About
  </MudNavLink>

  <AuthorizeView>
    <Authorized>
      <MudNavLink Href="Account/Manage" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">
        Account
      </MudNavLink>
      @if (RendererInfo.IsInteractive && OperatingSystem.IsBrowser())
      {
        <button type="button" class="mud-nav-link mud-ripple" @onclick="HandleLogoutClicked">
          <MudIcon Icon="@Icons.Material.Filled.Logout" Color="Color.Info" Class="mr-3"></MudIcon> Logout
        </button>
      }
      else
      {
        <form action="Account/Logout" method="post">
          <AntiforgeryToken />
          <input type="hidden" name="ReturnUrl" value="@_currentUrl" />
          <button type="submit" class="mud-nav-link mud-ripple">
            <MudIcon Icon="@Icons.Material.Filled.Logout" Color="Color.Info" Class="mr-3"></MudIcon> Logout
          </button>
        </form>
      }
    </Authorized>
    <NotAuthorized>
      @if (_isPublicRegistrationEnabled)
      {
        <MudNavLink Href="Account/Register" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">
          Register
        </MudNavLink>
      }
      <MudNavLink Href="Account/Login" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Password">
        Login
      </MudNavLink>
    </NotAuthorized>
  </AuthorizeView>
</MudNavMenu>

@code {

  private static readonly string[] TenantAdminSectionPolicies =
  [
    PolicyNames.RequirePermissionAssignmentsRead,
    PolicyNames.RequireUsersRead,
    PolicyNames.RequireTenantUsersWrite,
    PolicyNames.RequireUserGroupsRead,
    PolicyNames.RequireDeviceGroupsRead,
    PolicyNames.RequireCustomersRead,
    PolicyNames.RequireTagsWrite,
    PolicyNames.RequireServiceAccountRead,
    PolicyNames.RequireTenantSettingsRead,
    PolicyNames.RequireAuthorizationLogsRead,
  ];

  private static readonly string[] ServerAdminSectionPolicies =
  [
    PolicyNames.RequireServerServiceAccountsRead,
    PolicyNames.RequireServerSettingsWrite,
    PolicyNames.RequireServerAuthorizationLogsRead,
    PolicyNames.RequireServerTelemetryRead,
  ];

  private string? _currentUrl;
  private bool _isAuthenticated;
  private bool _isPublicRegistrationEnabled;
  private bool _canSeeTenantAdmin;
  private bool _canSeeServerAdmin;
  private bool _canSeeServerAuthorizationLogs;

  public void Dispose()
  {
    NavMan.LocationChanged -= OnLocationChanged;
    AuthState.AuthenticationStateChanged -= HandleAuthStateChanged;
  }

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();

    _isPublicRegistrationEnabled = (await PublicRegistingsProvider.GetPublicServerSettings()).IsPublicRegistrationEnabled;

    var state = await AuthState.GetAuthenticationStateAsync();
    _isAuthenticated = state.User.IsAuthenticated();
    UpdateSectionVisibility(state.User);

    AuthState.AuthenticationStateChanged += HandleAuthStateChanged;
    _currentUrl = NavMan.ToBaseRelativePath(NavMan.Uri);
    NavMan.LocationChanged += OnLocationChanged;
  }

  private async void HandleAuthStateChanged(Task<AuthenticationState> stateTask)
  {
    try
    {
      var state = await stateTask;
      _isAuthenticated = state.User.IsAuthenticated();
      UpdateSectionVisibility(state.User);
      await InvokeAsync(StateHasChanged);
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error while handling auth state change.");
    }
  }

  private async Task HandleLogoutClicked()
  {
    if (!RendererInfo.IsInteractive)
    {
      return;
    }

    var result = await ControlrApi.Value.Auth.LogOut();
    if (!result.IsSuccess)
    {
      Snackbar.Add("Logout failed", Severity.Error);
      return;
    }

    NavMan.NavigateTo("/", true);
  }

  private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
  {
    _currentUrl = NavMan.ToBaseRelativePath(e.Location);
    InvokeAsync(StateHasChanged);
  }

  private void UpdateSectionVisibility(ClaimsPrincipal user)
  {
    _canSeeTenantAdmin = HasAnyPolicy(user, TenantAdminSectionPolicies);
    _canSeeServerAdmin = HasAnyPolicy(user, ServerAdminSectionPolicies);
    _canSeeServerAuthorizationLogs = user.HasClientPolicy(PolicyNames.RequireServerAuthorizationLogsRead);
  }

  private static bool HasAnyPolicy(ClaimsPrincipal user, string[] policies)
  {
    return policies.Any(policy => user.HasClientPolicy(policy));
  }
}
